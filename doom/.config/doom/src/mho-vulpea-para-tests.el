(ert-deftest mho-vulpea-para-refile-targets-exclude-public-and-archives ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (let* ((area (mho-vulpea-para-capture-area "Learning"))
           (path (vulpea-note-path area))
           (public (mho-vulpea-para-test--write
                    "public.org" "Published essay" '("public")
                    (mho-vulpea-para-test--heading "Published section")))
           (both (mho-vulpea-para-test--write
                  "both.org" "Ambiguous visibility" '("public" "private")
                  (mho-vulpea-para-test--heading "Ambiguous section"))))
      (vulpea-db-update-file path)
      (let ((targets (org-refile-get-targets)))
        (dolist (heading '("Notes" "Tasks"))
          (should (seq-find (lambda (target)
                              (and (equal (nth 1 target) path)
                                   (string-suffix-p (concat "/" heading) (car target))))
                            targets)))
        (should-not (seq-find (lambda (target)
                               (or (member (nth 1 target)
                                           (list (vulpea-note-path public) (vulpea-note-path both)))
                                   (string-suffix-p "/Archive" (car target))))
                             targets))))))

