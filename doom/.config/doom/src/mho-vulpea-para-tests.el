    (dolist (fixture
             '(("commented.org" . "* COMMENT Discarded plan\n** NEXT Ignored action :REFILE:\n<2030-10-21 Mon>\n")
               ("archived-property.org" . "* Old project\n:PROPERTIES:\n:ARCHIVE_TIME: [2026-10-01 Thu 10:00]\n:END:\n** NEXT Old action :REFILE:\n<2030-10-21 Mon>\n")))
      (let ((note (mho-vulpea-para-test--write
                   (car fixture) "Hidden work" '("private" "agenda") (cdr fixture))))
        (should-not (member "agenda" (vulpea-note-tags note)))
        (should-not (member (vulpea-note-path note) (vulpea-para-agenda-files)))
        (with-current-buffer (find-file-noselect (vulpea-note-path note))
          (should-not (vulpea-para-buffer-open-work-p)))))))

