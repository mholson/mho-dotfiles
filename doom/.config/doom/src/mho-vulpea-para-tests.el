;;; mho-vulpea-para-tests.el --- Isolated PARA integration checks -*- lexical-binding: t; -*-

;;; Commentary:
;; Exercise the local configuration with real Org capture and a disposable
;; Vulpea database.  Neither the user's notes nor their database are opened.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'org-capture)
(require 'org-agenda)
(require 'vulpea-db-extract)
(require 'mho-vulpea-para)

(defconst mho-vulpea-para-test--uuid-regexp
  "\\`[[:xdigit:]]\\{8\\}-[[:xdigit:]]\\{4\\}-[[:xdigit:]]\\{4\\}-[[:xdigit:]]\\{4\\}-[[:xdigit:]]\\{12\\}\\'")

(defmacro mho-vulpea-para-test--with-vault (&rest body)
  "Run BODY with isolated notes, database, Org settings and buffers."
  (declare (indent 0) (debug t))
  `(let* ((root (make-temp-file "mho-vulpea-para-test-" t))
          (notes (expand-file-name "notes/" root))
          (data (expand-file-name "data/" root))
          (default-directory root)
          (user-emacs-directory data)
          (org-directory notes)
          (org-default-notes-file (expand-file-name "inbox.org" notes))
          (org-id-method 'uuid)
          (org-id-locations-file (expand-file-name "org-id-locations" data))
          (org-id-locations (make-hash-table :test #'equal))
          (org-id-files nil)
          (org-id-extra-files nil)
          (org-mode-hook nil)
          (org-capture-mode-hook nil)
          (org-capture-before-finalize-hook nil)
          (org-capture-after-finalize-hook nil)
          (org-agenda-mode-hook nil)
          (org-agenda-finalize-hook nil)
          (org-agenda-files nil)
          (org-agenda-custom-commands nil)
          (org-agenda-prefix-format nil)
          (org-capture-templates nil)
          (org-capture-plist nil)
          (org-capture-last-stored-marker (make-marker))
          (org-capture-last-stored-marker-list nil)
          (org-refile-targets nil)
          (org-refile-use-outline-path nil)
          (org-outline-path-complete-in-steps nil)
          (org-refile-allow-creating-parent-nodes nil)
          (org-refile-target-verify-function nil)
          (org-log-done nil)
          (org-log-into-drawer nil)
          (org-tags-exclude-from-inheritance nil)
          (org-todo-keywords
           '((sequence "TODO(t)" "NEXT(n)" "LIVE(l)" "WAIT(w)" "SOME(s)"
                       "|" "DONE(d)" "XOUT(x)")
             (sequence "PROJ(p)" "|" "DONE(d)" "XOUT(x)")))
          (org-agenda-window-setup 'current-window)
          (org-agenda-buffer-name "*MHO PARA test agenda*")
          (vulpea-default-notes-directory notes)
          (vulpea-create-default-function nil)
          (vulpea-create-default-template '(:file-name "${id}--${slug}.org"))
          (vulpea-db-sync-directories (list notes))
          (vulpea-db-location (expand-file-name "vulpea.db" data))
          (vulpea-db--connection nil)
          (vulpea-db-exclude-archived t)
          (vulpea-para-open-work-files nil)
          (vulpea-para-capture-area-file-name "area/${timestamp}-${slug}.org")
          (vulpea-para-done-keywords '("DONE" "CANCELLED"))
          (vulpea-para-agenda-main-key " ")
          (vulpea-para-agenda-warn-missing nil)
          (vulpea-para-agenda--warned-missing nil)
          (vulpea-para-agenda-files-filter nil)
          (vulpea-para-refile-files-filter nil)
          (vulpea-para-agenda-mode nil)
          (vulpea-para-refile-mode nil)
          (initial-buffers (buffer-list)))
     (make-directory notes t)
     (make-directory data t)
     (unwind-protect
         (save-window-excursion
           (vulpea-db)
           ,@body)
       (when (bound-and-true-p org-capture-mode) (org-capture-kill))
       (vulpea-para-agenda-mode -1)
       (vulpea-para-refile-mode -1)
       (advice-remove 'vulpea-para-buffer-open-work-p #'mho-vulpea-para--open-work-p)
       (dolist (buffer (buffer-list))
         (unless (memq buffer initial-buffers)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (when vulpea-db--connection (vulpea-db-close))
       (delete-directory root t))))

(defun mho-vulpea-para-test--write (name title tags body)
  "Create and index fixture NAME with TITLE, TAGS and BODY."
  (let ((path (expand-file-name name org-directory))
        (id (org-id-new)))
    (with-current-buffer (find-file-noselect path)
      (erase-buffer)
      (insert (format ":PROPERTIES:\n:ID: %s\n:END:\n#+title: %s\n#+filetags: :%s:\n\n%s\n"
                      id title (string-join tags ":") body))
      (save-buffer))
    (vulpea-db-update-file path)
    (vulpea-db-get-by-id id)))

(defun mho-vulpea-para-test--heading (title &optional state tags)
  "Return a fixture heading TITLE with optional STATE and TAGS."
  (format "* %s%s%s\n:PROPERTIES:\n:ID: %s\n:END:\n"
          (if state (concat state " ") "") title
          (if tags (concat " :" (string-join tags ":") ":") "")
          (org-id-new)))

(defun mho-vulpea-para-test--read (path)
  "Read fixture PATH as plain text."
  (with-temp-buffer (insert-file-contents path) (buffer-string)))

(ert-deftest mho-vulpea-para-setup-preserves-existing-commands ()
  (mho-vulpea-para-test--with-vault
    (let ((capture '("t" "Existing task" entry (file "unused.org") "* TODO %?"))
          (agenda '("x" "Existing agenda" todo "NEXT"))
          (overview '("o" "Strategic Overview" todo "PROJ")))
      (setq org-capture-templates (list capture)
            org-agenda-custom-commands (list agenda overview))
      (mho-vulpea-para-setup)
      (mho-vulpea-para-setup)
      (should (equal (assoc "t" org-capture-templates) capture))
      (should (equal (assoc "x" org-agenda-custom-commands) agenda))
      (should (equal (assoc "o" org-agenda-custom-commands) overview))
      (should (= 1 (cl-count "p" org-capture-templates :key #'car :test #'equal)))
      (should (= 1 (cl-count "o" org-agenda-custom-commands :key #'car :test #'equal)))
      (should (equal vulpea-para-agenda-main-key "o"))
      (should (equal vulpea-para-done-keywords '("DONE" "XOUT")))
      (should vulpea-para-agenda-mode)
      (should vulpea-para-refile-mode)
      (should (advice-member-p #'vulpea-para-agenda-files-update #'org-agenda))
      (should (advice-member-p #'vulpea-para-refile--get-targets #'org-refile-get-targets)))))

(ert-deftest mho-vulpea-para-area-creation-is-private-and-addressable ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (let* ((area (mho-vulpea-para-capture-area "Learning"))
           (path (vulpea-note-path area))
           (id (vulpea-note-id area))
           (ids (list id)))
      (should (string-match-p mho-vulpea-para-test--uuid-regexp id))
      (should (equal (file-name-nondirectory path) (concat id "--learning.org")))
      (should (file-in-directory-p path notes))
      (should (equal (buffer-file-name) path))
      (should (member "area" (vulpea-note-tags area)))
      (should (member "private" (vulpea-note-tags area)))
      (should-not (member "public" (vulpea-note-tags area)))
      (vulpea-db-update-file path)
      (with-current-buffer (find-file-noselect path)
        (dolist (heading '("Notes" "Tasks" "Archive"))
          (goto-char (point-min))
          (should (re-search-forward (concat "^\\* " heading "\\(?:[ \t:]\\|$\\)") nil t))
          (org-back-to-heading t)
          (let ((heading-id (org-entry-get nil "ID")))
            (should (string-match-p mho-vulpea-para-test--uuid-regexp heading-id))
            (push heading-id ids)
            (if (equal heading "Archive")
                (progn (should (member "ARCHIVE" (org-get-tags nil t)))
                       (should-not (vulpea-db-get-by-id heading-id)))
              (should (vulpea-db-get-by-id heading-id))))))
      (should (= 4 (length (delete-dups ids)))))))

(ert-deftest mho-vulpea-para-area-creation-rejects-blank-title ()
  (mho-vulpea-para-test--with-vault
    (should-error (mho-vulpea-para-capture-area " \t\n ") :type 'user-error)
