(ert-deftest mho-vulpea-para-existing-capture-files-have-targets-and-are-not-overwritten ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (dolist (name '("work.org" "home.org"))
      (let* ((area (mho-vulpea-para-capture-area (file-name-base name) name))
             (path (vulpea-note-path area))
             (before (mho-vulpea-para-test--read path)))
        (should (equal path (expand-file-name name notes)))
        (with-current-buffer (find-file-noselect path)
          (dolist (heading '("Inbox" "Actions" "Meetings"))
            (goto-char (point-min))
            (should (re-search-forward (concat "^\\* " heading "\\(?:[ \t:]\\|$\\)") nil t))
            (org-back-to-heading t)
            (should (string-match-p mho-vulpea-para-test--uuid-regexp
                                    (org-entry-get nil "ID")))))
        (should-error (mho-vulpea-para-capture-area "Replacement" name) :type 'user-error)
        (should (equal before (mho-vulpea-para-test--read path)))))))

(ert-deftest mho-vulpea-para-project-capture-targets-area-tasks ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (let* ((area (mho-vulpea-para-capture-area "Learning"))
           (path (vulpea-note-path area)))
      (cl-letf (((symbol-function 'vulpea-select-from)
                 (lambda (_prompt candidates &rest _)
                   (should (seq-find (lambda (note)
                                       (equal (vulpea-note-id note) (vulpea-note-id area)))
                                     candidates))
                   area))
                ((symbol-function 'read-string) (lambda (&rest _) "Build a small tool")))
        (mho-vulpea-para-capture-project)
        (should (bound-and-true-p org-capture-mode))
        (org-capture-finalize))
      (vulpea-db-update-file path)
      (let ((projects (vulpea-para-projects-in-area area)))
        (should (= 1 (length projects)))
        (let ((project (car projects)))
          (should (equal (vulpea-note-title project) "Build a small tool"))
          (should (equal (vulpea-note-todo project) "PROJ"))
          (should (= 2 (vulpea-note-level project)))
          (should (string-match-p mho-vulpea-para-test--uuid-regexp (vulpea-note-id project)))
          (with-current-buffer (find-file-noselect path)
            (goto-char (vulpea-note-pos project))
            (should (equal (org-entry-get nil "CATEGORY") "Learning > Build a small tool"))
            (should (org-up-heading-safe))
            (should (equal (org-get-heading t t t t) "Tasks"))))))))

(ert-deftest mho-vulpea-para-dynamic-agenda-respects-custom-states ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (dolist (state '("NEXT" "LIVE" "PROJ" "DONE" "XOUT"))
      (let* ((note (mho-vulpea-para-test--write
                    (concat (downcase state) ".org") state '("private")
                    (mho-vulpea-para-test--heading (concat state " fixture") state)))
             (path (vulpea-note-path note))
             (open (member state '("NEXT" "LIVE" "PROJ"))))
        (should (eq (and open t) (and (member "agenda" (vulpea-note-tags note)) t)))
        (should (eq (and open t) (and (member path (vulpea-para-agenda-files)) t)))
        (when open
          (with-current-buffer (find-file-noselect path)
            (goto-char (point-min))
            (re-search-forward "^\\* ")
            (org-back-to-heading t)
            (org-todo "DONE")
            (save-buffer))
          (vulpea-db-update-file path)
          (should-not (member path (vulpea-para-agenda-files)))
          (with-current-buffer (find-file-noselect path)
            (org-todo state)
            (save-buffer))
          (vulpea-db-update-file path)
          (should (member path (vulpea-para-agenda-files))))
        ;; Database-side drift detection must use the same done states.
        (with-current-buffer (find-file-noselect path)
          (goto-char (point-min))
          (vulpea-buffer-tags-remove "agenda")
          (let ((before-save-hook nil)) (save-buffer)))
        (vulpea-db-update-file path)
        (should (eq (and open t) (and (member path (vulpea-para-agenda-missing-files)) t)))))))

(ert-deftest mho-vulpea-para-project-tag-does-not-turn-tasks-into-projects ()
