(ert-deftest mho-vulpea-para-area-agenda-stays-scoped ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (let* ((selected (mho-vulpea-para-test--write
                      "selected.org" "Selected" '("area" "private")
                      (mho-vulpea-para-test--heading "Selected area task" "NEXT")))
           (other (mho-vulpea-para-test--write
                   "other.org" "Other" '("area" "private")
                   (mho-vulpea-para-test--heading "Other area task" "NEXT"))))
      (setq org-agenda-files (list (vulpea-note-path selected) (vulpea-note-path other)))
      (let ((before (copy-sequence org-agenda-files)))
        (cl-letf (((symbol-function 'vulpea-select-from) (lambda (&rest _) selected)))
          (vulpea-para-agenda-area))
        (should (derived-mode-p 'org-agenda-mode))
        (should (string-match-p "Selected area task" (buffer-string)))
        (should-not (string-match-p "Other area task" (buffer-string)))
        (should (equal org-agenda-files before))))))

(ert-deftest mho-vulpea-para-archive-removes-project-from-live-index ()
  (mho-vulpea-para-test--with-vault
    (mho-vulpea-para-setup)
    (let* ((area (mho-vulpea-para-capture-area "Learning"))
           (path (vulpea-note-path area))
           (project-id (vulpea-para-capture-project area "Completed experiment"))
           (child-id (org-id-new)))
      (with-current-buffer (find-file-noselect path)
        (goto-char (point-min))
        (re-search-forward (regexp-quote project-id))
        (org-back-to-heading t)
        (org-todo "DONE")
        (org-end-of-subtree t t)
        (insert (format "*** NEXT Unfinished archived action\n:PROPERTIES:\n:ID: %s\n:END:\n"
                        child-id))
        (save-buffer))
      (vulpea-db-update-file path)
      (should (member path (vulpea-para-agenda-files)))
      (should (vulpea-db-get-by-id child-id))
      (let ((project (vulpea-db-get-by-id project-id)))
        (should project)
        (vulpea-para-archive-project project))
      (vulpea-db-update-file path)
      (should-not (vulpea-db-get-by-id project-id))
      (should-not (vulpea-db-get-by-id child-id))
      (should-not (vulpea-para-projects-in-area area))
      (should-not (member path (vulpea-para-agenda-files)))
      (should-not (member "agenda" (vulpea-note-tags (vulpea-db-get-by-id (vulpea-note-id area)))))
      (should-not (vulpea-para-doctor-stale-agenda-files))
      (should-not (vulpea-para-doctor-orphan-projects))
      (with-current-buffer (find-file-noselect path)
        (goto-char (point-min))
        (should (re-search-forward (regexp-quote project-id) nil t))
        (org-back-to-heading t)
        (should (equal (org-get-heading t t t t) "Completed experiment"))
        (should (org-up-heading-safe))
        (should (equal (org-get-heading t t t t) "Archive"))
        (should (member "ARCHIVE" (org-get-tags nil t)))))))

(ert-deftest mho-vulpea-para-hidden-subtrees-do-not-keep-agenda-tags ()
